  "tests": [
    {
      "id": "tool-faults",
      "kind": "fault_injection",
      "expected": "temporary fixture survives failures before object publish, after backup rename, and after link publish with exact bytes"
    },
    {
      "id": "inventory-parity",
      "kind": "parity",
      "expected": "18 paths, 3,563,522,494 logical bytes, 15 unique objects, and sufficient store capacity"
    },
    {
      "id": "object-stage-fault",
      "kind": "fault_injection",
      "expected": "failed object copy leaves every original regular file untouched"
    },
    {
      "id": "projection-faults",
      "kind": "fault_injection",
      "expected": "backup-rename and link-publish failures are idempotently recoverable without byte loss"
    },
    {
      "id": "parent-mode-fault",
      "kind": "fault_injection",
      "expected": "handled failure restores parent mode immediately and simulated process loss is repaired from the durable mode journal"
    },
    {
      "id": "recovery-drill",
      "kind": "fault_injection",
      "expected": "one ELF, one perf.data, and one source snapshot materialize, verify, and externalize again"
    },
    {
      "id": "payload-parity",
      "kind": "parity",
      "expected": "18/18 historical paths and 15/15 objects match sealed size and SHA-256"
    },
    {
      "id": "catalog-parity",
      "kind": "parity",
      "expected": "catalog and inventory have identical sorted entry identities"
    },
    {
      "id": "catalog-seal-fault",
      "kind": "fault_injection",
      "expected": "interrupted catalog publication retains a recoverable draft and every verified object projection"
    },
    {
      "id": "historical-ledger-parity",
      "kind": "parity",
      "expected": "scripts/research/SHA256SUMS passes 122/122 and tracked receipt diff is empty"
    },
    {
      "id": "command-graph-parity",
      "kind": "unit",
      "expected": "tool imports only Python standard-library filesystem and hashing modules and exposes no subprocess or network route"
    }
  ]
