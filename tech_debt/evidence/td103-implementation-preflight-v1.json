  "state_machine": {
    "initial_state": "PREFLIGHT_READY",
    "terminal_states": [
      "TD103_COMPLETE",
      "BLOCKED_TOOL",
      "BLOCKED_INVENTORY",
      "BLOCKED_STAGING_ORIGINALS_INTACT",
      "BLOCKED_MIGRATION_RECOVERABLE",
      "BLOCKED_RECOVERY_DRILL"
    ],
    "steps": [
      {
        "id": "implement-and-self-check-tool",
        "from": "PREFLIGHT_READY",
        "to": "TOOL_VERIFIED",
        "mutates": true,
        "failure_state": "BLOCKED_TOOL",
        "cleanup": "retain source and test output; do not touch admitted payload paths",
        "preserves": ["inventory", "elf-bytes", "perf-bytes", "source-bytes"],
        "test_id": "tool-faults"
      },
      {
        "id": "verify-inventory-and-capacity",
        "from": "TOOL_VERIFIED",
        "to": "INVENTORY_VERIFIED",
        "mutates": false,
        "failure_state": "BLOCKED_INVENTORY",
        "cleanup": "no object or payload path mutation",
        "preserves": ["inventory", "elf-bytes", "perf-bytes", "source-bytes"],
        "test_id": "inventory-parity"
      },
      {
        "id": "stage-content-objects",
        "from": "INVENTORY_VERIFIED",
        "to": "OBJECTS_VERIFIED",
        "mutates": true,
        "failure_state": "BLOCKED_STAGING_ORIGINALS_INTACT",
        "cleanup": "remove incomplete temporary objects; original receipt paths remain regular and byte-identical",
        "preserves": ["inventory", "elf-bytes", "perf-bytes", "source-bytes"],
        "test_id": "object-stage-fault"
      },
      {
        "id": "publish-content-projections",
        "from": "OBJECTS_VERIFIED",
        "to": "PROJECTIONS_EXTERNALIZED",
        "mutates": true,
        "failure_state": "BLOCKED_MIGRATION_RECOVERABLE",
        "cleanup": "recover any transaction backup or temporary link, then verify every dereferenced path",
        "preserves": ["inventory", "elf-bytes", "perf-bytes", "source-bytes"],
        "test_id": "projection-faults"
      },
      {
        "id": "recovery-drill",
        "from": "PROJECTIONS_EXTERNALIZED",
        "to": "RECOVERY_VERIFIED",
        "mutates": true,
        "failure_state": "BLOCKED_RECOVERY_DRILL",
        "cleanup": "retain verified objects and whichever byte-identical regular or symlink projection is present",
        "preserves": ["inventory", "elf-bytes", "perf-bytes", "source-bytes"],
        "test_id": "recovery-drill"
      },
      {
        "id": "seal-catalog",
        "from": "RECOVERY_VERIFIED",
        "to": "TD103_COMPLETE",
        "mutates": true,
        "failure_state": "BLOCKED_MIGRATION_RECOVERABLE",
        "cleanup": "retain all verified objects, projections, journal, and draft receipt",
        "preserves": ["inventory", "elf-bytes", "perf-bytes", "source-bytes"],
        "test_id": "catalog-seal-fault"
      }
    ]
  },
