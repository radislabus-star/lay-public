+static void
+_context_require_surrounding_text_cb (IBusInputContext *context,
+                                      gpointer          data)
+{
+    IBusWaylandIMPrivate *priv =
+            ibus_wayland_im_get_instance_private (IBUS_WAYLAND_IM (data));
+    const gchar *text;
+
+    /* Only a callback from this activation can populate surrounding_text;
+     * input_method_deactivate clears it before another context is created.
+     */
+    if (context == NULL || context != priv->ibuscontext ||
+        priv->surrounding_text == NULL ||
+        !ibus_input_context_needs_surrounding_text (context))
+        return;
+
+    text = priv->surrounding_text->text;
+    /* The API consumes a floating text, including on duplicate delivery. */
+    ibus_input_context_set_surrounding_text (
+            context,
+            ibus_text_new_from_string (text),
+            g_utf8_pointer_to_offset (text, text + priv->surrounding_cursor_pos),
+            g_utf8_pointer_to_offset (text, text + priv->surrounding_anchor_pos));
+}
+#endif
