{
  "schema": "nanda.code-route-gate.v2",
  "scope": "design",
  "nodes": [
    {"id": "quality_cli", "role": "interface"},
    {"id": "quality_orchestrator", "role": "orchestrator"},
    {"id": "a2_prerequisite", "role": "proof_owner"},
    {"id": "fixed_objective_builder", "role": "proof_owner"},
    {"id": "typed_basin_producer", "role": "producer"},
    {"id": "exact_implicit_producer", "role": "producer"},
    {"id": "exact_settlement_producer", "role": "producer"},
    {"id": "exact_readout_producer", "role": "producer"},
    {"id": "quality_gate", "role": "proof_owner"},
    {"id": "legacy_v8_observer", "role": "observer"},
    {"id": "quality_metrics", "role": "observer"},
    {"id": "quality_receipt", "role": "observer"}
  ],
  "edges": [
    {
      "id": "exec_cli_orchestrator",
      "from": "quality_cli",
      "relation": "calls",
      "to": "quality_orchestrator",
      "events": ["damaged_quality", "clean_quality"]
    },
    {
      "id": "exec_damaged_typed",
      "from": "quality_orchestrator",
      "relation": "calls",
      "to": "typed_basin_producer",
      "events": ["damaged_quality", "clean_quality"]
    },
    {
      "id": "exec_typed_implicit",
      "from": "typed_basin_producer",
      "relation": "delegates",
      "to": "exact_implicit_producer",
      "events": ["damaged_quality", "clean_quality"]
    },
    {
      "id": "exec_implicit_settlement",
      "from": "exact_implicit_producer",
      "relation": "delegates",
      "to": "exact_settlement_producer",
      "events": ["damaged_quality", "clean_quality"]
    },
    {
      "id": "exec_settlement_readout",
      "from": "exact_settlement_producer",
      "relation": "delegates",
      "to": "exact_readout_producer",
      "events": ["damaged_quality", "clean_quality"]
    },
    {
      "id": "proof_readout_quality",
      "from": "exact_readout_producer",
      "relation": "delegates",
      "to": "quality_gate",
      "events": ["damaged_quality", "clean_quality"]
    },
    {
      "id": "proof_a2_quality",
      "from": "a2_prerequisite",
      "relation": "proves",
      "to": "quality_gate",
      "events": ["a2_prerequisite"]
    },
    {
      "id": "proof_objective_quality",
      "from": "fixed_objective_builder",
      "relation": "proves",
      "to": "quality_gate",
      "events": ["objective_quality"]
    },
    {
      "id": "observe_legacy_metrics",
      "from": "legacy_v8_observer",
      "relation": "observes",
      "to": "quality_metrics",
      "events": ["legacy_observation"]
    },
    {
      "id": "observe_gate_metrics",
      "from": "quality_gate",
      "relation": "observes",
      "to": "quality_metrics",
      "events": ["quality_report"]
    },
    {
      "id": "observe_metrics_receipt",
      "from": "quality_metrics",
      "relation": "observes",
      "to": "quality_receipt",
      "events": ["quality_report", "legacy_observation"]
    }
  ],
  "routes": [
    {
      "id": "damaged-quality-execution",
      "event": "damaged_quality",
      "kind": "execution",
      "entry": "quality_cli",
      "terminal": "quality_gate",
      "required_roles": ["interface", "orchestrator", "producer", "proof_owner"],
      "via": [
        "quality_orchestrator",
        "typed_basin_producer",
        "exact_implicit_producer",
        "exact_settlement_producer",
        "exact_readout_producer"
      ],
      "path_cardinality": [
        {"from": "quality_cli", "to": "quality_gate", "min": 1, "max": 1}
      ]
    },
    {
      "id": "clean-quality-execution",
      "event": "clean_quality",
      "kind": "execution",
      "entry": "quality_cli",
      "terminal": "quality_gate",
      "required_roles": ["interface", "orchestrator", "producer", "proof_owner"],
      "via": [
        "quality_orchestrator",
        "typed_basin_producer",
        "exact_implicit_producer",
        "exact_settlement_producer",
        "exact_readout_producer"
      ],
      "path_cardinality": [
        {"from": "quality_cli", "to": "quality_gate", "min": 1, "max": 1}
      ]
    },
    {
      "id": "a2-prerequisite-proof",
      "event": "a2_prerequisite",
      "kind": "proof",
      "entry": "a2_prerequisite",
      "terminal": "quality_gate",
      "required_roles": ["proof_owner"]
    },
    {
      "id": "objective-quality-proof",
      "event": "objective_quality",
      "kind": "proof",
      "entry": "fixed_objective_builder",
      "terminal": "quality_gate",
      "required_roles": ["proof_owner"]
    },
    {
      "id": "legacy-v8-observation",
      "event": "legacy_observation",
      "kind": "observation",
      "entry": "legacy_v8_observer",
      "terminal": "quality_receipt",
      "required_roles": ["observer"],
      "via": ["quality_metrics"]
    },
    {
      "id": "quality-report-observation",
      "event": "quality_report",
      "kind": "observation",
      "entry": "quality_gate",
      "terminal": "quality_receipt",
      "required_roles": ["proof_owner", "observer"],
      "via": ["quality_metrics"]
    }
  ]
}
