    {"id": "witness-overflow-singleton-abstains", "denominator": "evidence_completeness", "phase": "future_contract", "first_required_slice": 4, "required_test": "one_retained_target_with_witness_overflow_abstains", "expected": "an incomplete singleton is ABSTAIN rather than Winner or one-member Tied"},
