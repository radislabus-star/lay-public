    {"id": "born-alternative-blocks-winner", "denominator": "evidence_completeness", "phase": "future_contract", "first_required_slice": 4, "required_test": "conflicting_born_target_blocks_grounded_singleton_authority", "expected": "one Grounded target plus one unresolved conflicting Born target yields ABSTAIN(IncompleteEnumeration), never Winner"},
    {"id": "absent-grounding-requires-complete-search", "denominator": "evidence_completeness", "phase": "future_contract", "first_required_slice": 3, "required_test": "target_absent_rejection_requires_complete_grounding_namespace", "expected": "Overflow or Failed grounding lookup leaves the target Born and authority-blocking instead of rejecting it as absent"},
    {"id": "canonical-cohort-order", "denominator": "evidence_completeness", "phase": "future_contract", "first_required_slice": 4, "required_test": "cohort_hash_is_invariant_to_producer_and_arrival_order", "expected": "canonical target and footprint bytes, never score or provenance order, define the context-visible cohort hash"},
