{
  "schema": "nanda.code-route-gate.v2",
  "scope": "design",
  "nodes": [
    {"id": "phase8e_proof_cli", "role": "interface"},
    {"id": "phase8e_orchestrator", "role": "orchestrator"},
    {"id": "complete_posting_adapter", "role": "producer"},
    {"id": "sharded_epoch_accumulator", "role": "producer"},
    {"id": "typed_edit_traversal", "role": "producer"},
    {"id": "terminal_evidence_union", "role": "evidence_owner"},
    {"id": "exact_kth_readout", "role": "candidate_rank_owner"},
    {"id": "dense_accumulator_oracle", "role": "proof_owner"},
    {"id": "closure_parity_gate", "role": "proof_owner"},
    {"id": "phase8e_metrics", "role": "observer"},
    {"id": "phase8e_receipt", "role": "observer"}
  ],
  "edges": [
    {"id": "exec-cli-orchestrator", "from": "phase8e_proof_cli", "relation": "calls", "to": "phase8e_orchestrator", "events": ["phase8e_query"]},
    {"id": "exec-orchestrator-postings", "from": "phase8e_orchestrator", "relation": "calls", "to": "complete_posting_adapter", "events": ["phase8e_query"]},
    {"id": "exec-postings-accumulator", "from": "complete_posting_adapter", "relation": "delegates", "to": "sharded_epoch_accumulator", "events": ["phase8e_query"]},
    {"id": "exec-orchestrator-typed", "from": "phase8e_orchestrator", "relation": "calls", "to": "typed_edit_traversal", "events": ["phase8e_query"]},
    {"id": "exec-accumulator-union", "from": "sharded_epoch_accumulator", "relation": "delegates", "to": "terminal_evidence_union", "events": ["phase8e_query"]},
    {"id": "exec-typed-union", "from": "typed_edit_traversal", "relation": "delegates", "to": "terminal_evidence_union", "events": ["phase8e_query"]},
    {"id": "exec-union-readout", "from": "terminal_evidence_union", "relation": "delegates", "to": "exact_kth_readout", "events": ["phase8e_query"]},
    {"id": "proof-postings-oracle", "from": "complete_posting_adapter", "relation": "proves", "to": "dense_accumulator_oracle", "events": ["phase8e_query"]},
    {"id": "proof-oracle-parity", "from": "dense_accumulator_oracle", "relation": "proves", "to": "closure_parity_gate", "events": ["phase8e_query"]},
    {"id": "proof-readout-parity", "from": "exact_kth_readout", "relation": "proves", "to": "closure_parity_gate", "events": ["phase8e_query"]},
    {"id": "observe-parity-metrics", "from": "closure_parity_gate", "relation": "observes", "to": "phase8e_metrics", "events": ["phase8e_query"]},
    {"id": "observe-metrics-receipt", "from": "phase8e_metrics", "relation": "observes", "to": "phase8e_receipt", "events": ["phase8e_query"]}
  ],
  "routes": [
    {
      "id": "phase8e-posting-execution",
      "event": "phase8e_query",
      "kind": "execution",
      "entry": "phase8e_proof_cli",
      "terminal": "exact_kth_readout",
      "required_roles": ["interface", "orchestrator", "producer", "evidence_owner", "candidate_rank_owner"],
      "via": ["complete_posting_adapter", "sharded_epoch_accumulator"],
      "path_cardinality": [
        {"from": "phase8e_proof_cli", "to": "phase8e_orchestrator", "min": 1, "max": 1},
        {"from": "complete_posting_adapter", "to": "sharded_epoch_accumulator", "min": 1, "max": 1}
      ]
    },
    {
      "id": "phase8e-typed-execution",
      "event": "phase8e_query",
      "kind": "execution",
      "entry": "phase8e_orchestrator",
      "terminal": "terminal_evidence_union",
      "required_roles": ["orchestrator", "producer", "evidence_owner"],
      "via": ["typed_edit_traversal"]
    },
    {
      "id": "phase8e-proof",
      "event": "phase8e_query",
      "kind": "proof",
      "entry": "dense_accumulator_oracle",
      "terminal": "closure_parity_gate",
      "required_roles": ["proof_owner"]
    },
    {
      "id": "phase8e-observation",
      "event": "phase8e_query",
      "kind": "observation",
      "entry": "closure_parity_gate",
      "terminal": "phase8e_receipt",
      "required_roles": ["proof_owner", "observer"]
    }
  ]
}
