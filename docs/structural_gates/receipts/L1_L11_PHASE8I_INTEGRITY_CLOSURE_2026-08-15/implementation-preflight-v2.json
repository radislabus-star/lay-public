  "state_machine": {
    "initial_state": "POST_DEPLOY_INTEGRITY_REVIEW",
    "terminal_states": [
      "LOCAL_GATES_PASS",
      "REMOTE_PROOF_PASS",
      "DEPLOYED",
      "IMPLEMENTATION_REJECTED",
      "PROOF_REJECTED",
      "DEPLOY_REJECTED"
    ],
    "steps": [
      {
        "id": "implement-integrity-closure",
        "from": "POST_DEPLOY_INTEGRITY_REVIEW",
        "to": "INTEGRITY_CLOSURE_IMPLEMENTED",
        "mutates": true,
        "failure_state": "IMPLEMENTATION_REJECTED",
        "cleanup": "retain rejected diff and receipts; do not build release binaries or restart processes",
        "preserves": [
          "installed-v9",
          "installed-binaries",
          "installed-receipt"
        ],
        "test_id": "implementation-failure"
      },
      {
        "id": "run-local-integrity-gates",
        "from": "INTEGRITY_CLOSURE_IMPLEMENTED",
        "to": "LOCAL_GATES_PASS",
        "mutates": true,
        "failure_state": "IMPLEMENTATION_REJECTED",
        "cleanup": "retain test evidence and leave installed runtime byte-identical",
        "preserves": [
          "installed-v9",
          "installed-binaries",
          "installed-receipt"
        ],
        "test_id": "local-gate-failure"
      },
      {
        "id": "run-remote-fixed-quality-proof",
        "from": "LOCAL_GATES_PASS",
        "to": "REMOTE_PROOF_PASS",
        "mutates": true,
        "failure_state": "PROOF_REJECTED",
        "cleanup": "stop only remote proof processes and retain rejected receipts; live Lay remains unchanged",
        "preserves": [
          "installed-v9",
          "installed-binaries",
          "installed-receipt"
        ],
        "test_id": "remote-proof-failure"
      },
      {
        "id": "deploy-after-proof-and-release-gates",
        "from": "REMOTE_PROOF_PASS",
        "to": "DEPLOYED",
        "mutates": true,
        "failure_state": "DEPLOY_REJECTED",
        "cleanup": "restore pinned binaries and receipt, restart only managed Lay services, and never restart global IBus",
        "preserves": [
          "installed-v9",
          "installed-binaries",
          "installed-receipt"
        ],
        "test_id": "deploy-failure"
      }
    ]
  },
