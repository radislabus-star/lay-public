  "invariants": [
    {
      "id": "v9-proof-is-direct",
      "statement": "A V9 quality proof consumes the exact V9 bytes named by the receipt and never extracts, discovers, or falls back to a V8 artifact.",
      "test_id": "v9-no-fallback"
    },
    {
      "id": "stored-support-is-authority",
      "statement": "Quality settlement for V9 consumes exact support decoded from V9 only after byte-for-byte equality with an independent corpus rebuild.",
      "test_id": "v9-support-parity"
    },
    {
      "id": "v8-route-remains-separated",
      "statement": "V8 diagnostics retain the existing embedded A2 prerequisite and cannot produce a V9-admissible artifact claim.",
      "test_id": "v8-route-separation"
    },
    {
      "id": "schema-consumers-match-producer",
      "statement": "The proof producer, installer, and runtime admission require the same direct-V9 prerequisite fields and reject any missing or false field.",
      "test_id": "proof-consumer-parity"
    }
  ],
  "state_machine": {
    "initial_state": "DIRECT_V9_PROOF_GAP_CONFIRMED",
    "terminal_states": ["LOCAL_GATES_PASS", "REMOTE_PROOF_PASS", "DEPLOYED", "IMPLEMENTATION_REJECTED", "PROOF_REJECTED", "DEPLOY_REJECTED"],
    "steps": [
      {
        "id": "implement-direct-v9-proof",
        "from": "DIRECT_V9_PROOF_GAP_CONFIRMED",
        "to": "DIRECT_V9_PROOF_IMPLEMENTED",
        "mutates": true,
        "failure_state": "IMPLEMENTATION_REJECTED",
        "cleanup": "retain the rejected diff and failure receipt; leave installed package, binaries, daemon, and IBus unchanged",
        "preserves": ["installed-v9"],
        "test_id": "implementation-failure"
      },
      {
        "id": "run-local-gates",
        "from": "DIRECT_V9_PROOF_IMPLEMENTED",
        "to": "LOCAL_GATES_PASS",
        "mutates": true,
        "failure_state": "IMPLEMENTATION_REJECTED",
        "cleanup": "retain local evidence; do not sync a failed source packet",
        "preserves": ["installed-v9"],
        "test_id": "local-gate-failure"
      },
      {
        "id": "run-remote-proof",
        "from": "LOCAL_GATES_PASS",
        "to": "REMOTE_PROOF_PASS",
        "mutates": true,
        "failure_state": "PROOF_REJECTED",
        "cleanup": "retain smoke or full rejection receipt and stop only proof-owned remote processes",
        "preserves": ["installed-v9"],
        "test_id": "remote-proof-failure"
      },
      {
        "id": "deploy-after-proof",
        "from": "REMOTE_PROOF_PASS",
        "to": "DEPLOYED",
        "mutates": true,
        "failure_state": "DEPLOY_REJECTED",
        "cleanup": "restore pinned binaries and receipt and restart only managed Lay services; never restart global IBus",
        "preserves": ["installed-v9"],
        "test_id": "deploy-failure"
      }
    ]
  },
