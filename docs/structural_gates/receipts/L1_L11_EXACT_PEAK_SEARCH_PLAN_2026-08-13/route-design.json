{
  "schema": "nanda.code-route-gate.v2",
  "scope": "design",
  "nodes": [
    {"id": "readout_entry", "role": "interface"},
    {"id": "l1_peak_search", "role": "orchestrator"},
    {"id": "posting_nodes", "role": "producer"},
    {"id": "typed_edit_nodes", "role": "producer"},
    {"id": "wordcenter_accumulator", "role": "evidence_owner"},
    {"id": "nonlinear_settlement", "role": "candidate_rank_owner"},
    {"id": "restoration_authority", "role": "authorization_owner"},
    {"id": "search_diagnostics", "role": "observer"},
    {"id": "dense_oracle_parity", "role": "proof_owner"}
  ],
  "edges": [
    {"id": "exec-entry-owner", "from": "readout_entry", "relation": "calls", "to": "l1_peak_search", "events": ["exact_readout"]},
    {"id": "exec-owner-postings", "from": "l1_peak_search", "relation": "calls", "to": "posting_nodes", "events": ["exact_readout"]},
    {"id": "exec-owner-edit", "from": "l1_peak_search", "relation": "calls", "to": "typed_edit_nodes", "events": ["exact_readout"]},
    {"id": "exec-postings-accumulator", "from": "posting_nodes", "relation": "delegates", "to": "wordcenter_accumulator", "events": ["exact_readout"]},
    {"id": "exec-edit-accumulator", "from": "typed_edit_nodes", "relation": "delegates", "to": "wordcenter_accumulator", "events": ["exact_readout"]},
    {"id": "data-postings-accumulator", "from": "posting_nodes", "relation": "produces_for", "to": "wordcenter_accumulator", "events": ["exact_readout"]},
    {"id": "data-edit-accumulator", "from": "typed_edit_nodes", "relation": "produces_for", "to": "wordcenter_accumulator", "events": ["exact_readout"]},
    {"id": "data-accumulator-settlement", "from": "wordcenter_accumulator", "relation": "passes_to", "to": "nonlinear_settlement", "events": ["exact_readout"]},
    {"id": "authority-settlement-restoration", "from": "nonlinear_settlement", "relation": "passes_to", "to": "restoration_authority", "events": ["exact_readout"]},
    {"id": "observe-owner-diagnostics", "from": "l1_peak_search", "relation": "observes", "to": "search_diagnostics", "events": ["exact_readout"]},
    {"id": "prove-settlement-oracle", "from": "nonlinear_settlement", "relation": "proves", "to": "dense_oracle_parity", "events": ["oracle_compare"]}
  ],
  "routes": [
    {
      "id": "exact-readout-execution",
      "event": "exact_readout",
      "kind": "execution",
      "entry": "readout_entry",
      "terminal": "wordcenter_accumulator",
      "required_roles": ["interface", "orchestrator", "producer", "evidence_owner"],
      "path_cardinality": [
        {"from": "readout_entry", "to": "l1_peak_search", "min": 1, "max": 1},
        {"from": "l1_peak_search", "to": "wordcenter_accumulator", "min": 2, "max": 2}
      ]
    },
    {
      "id": "exact-readout-posting-authority",
      "event": "exact_readout",
      "kind": "authority",
      "entry": "posting_nodes",
      "terminal": "restoration_authority",
      "required_roles": ["producer", "evidence_owner", "candidate_rank_owner", "authorization_owner"],
      "path_cardinality": [
        {"from": "wordcenter_accumulator", "to": "restoration_authority", "via": ["nonlinear_settlement"], "min": 1, "max": 1}
      ]
    },
    {
      "id": "exact-readout-edit-authority",
      "event": "exact_readout",
      "kind": "authority",
      "entry": "typed_edit_nodes",
      "terminal": "restoration_authority",
      "required_roles": ["producer", "evidence_owner", "candidate_rank_owner", "authorization_owner"],
      "path_cardinality": [
        {"from": "wordcenter_accumulator", "to": "restoration_authority", "via": ["nonlinear_settlement"], "min": 1, "max": 1}
      ]
    },
    {
      "id": "exact-readout-observation",
      "event": "exact_readout",
      "kind": "observation",
      "entry": "l1_peak_search",
      "terminal": "search_diagnostics",
      "required_roles": ["orchestrator", "observer"]
    },
    {
      "id": "oracle-proof",
      "event": "oracle_compare",
      "kind": "proof",
      "entry": "nonlinear_settlement",
      "terminal": "dense_oracle_parity",
      "required_roles": ["candidate_rank_owner", "proof_owner"]
    }
  ]
}
