  "tests": [
    {"id": "source-edit-fault", "kind": "fault_injection", "expected": "an incomplete provenance or cache migration fails compile, focused tests, or observed route audit while installed 1.0.33 remains unchanged"},
    {"id": "typed-contour-relation-parity", "kind": "parity", "expected": "Identity, ExactLayout, LayoutThenTypo, and InverseGeometry remain distinct from extraction through V90 materialization"},
    {"id": "mixed-and-protected-input-proof", "kind": "integration", "expected": "mixed alphabetic wrong-layout contours enter the field while URL, CLI, technical, protected and known-clean-English inputs fail closed"},
    {"id": "cache-provenance-identity", "kind": "parity", "expected": "different ordered contours, relation tags, L1.1 lattices, inverse refs, scenes or package hashes cannot share one prepared field"},
    {"id": "inverse-grounding-boundary", "kind": "integration", "expected": "bounded canonical inverse forms may ground V90 but never become independent L1.1 authority or bypass common L3 and DecisionCore"},
    {"id": "single-owner-route-proof", "kind": "parity", "expected": "Nanda-enabled source cardinality and runtime trace agree on one canonical field producer, one Productive V90, one final lattice and one DecisionCore with zero deterministic or short-layout side donors"},
    {"id": "focused-ime-36", "kind": "integration", "expected": "the compatible-package IME proof passes 36 of 36 after diagnostic source assertions are migrated to typed semantics"},
    {"id": "remote-systemic-proof", "kind": "integration", "expected": "remote guarded checks pass fixed lexical, layout, mixed-script, boundary, clean-preservation, false-authority, false-split, latency and RSS contracts"},
    {"id": "rollback-and-verifier-proof", "kind": "integration", "expected": "the unchanged verifier authorizes only a valid edit plan and immediate double Shift restores the exact pre-autocorrection token"}
  ],
  "invariants": [
    {"id": "layout-is-candidate-relation", "statement": "layout is derived per candidate surface or grounded lemma and never from one request-wide boolean", "test_id": "typed-contour-relation-parity"},
    {"id": "inverse-is-not-l11-authority", "statement": "canonical inverse geometry is bounded V90 grounding evidence and cannot impersonate an L1.1 observation", "test_id": "inverse-grounding-boundary"},
    {"id": "one-live-candidate-owner", "statement": "deterministic and short-layout side donors are unreachable during a Nanda-enabled event", "test_id": "single-owner-route-proof"},
    {"id": "cache-binds-provenance", "statement": "prepared fields cannot be reused across a contour or provenance identity change", "test_id": "cache-provenance-identity"},
    {"id": "protected-input-fails-closed", "statement": "technical and protected surfaces never acquire lexical or layout authority through mixed projection", "test_id": "mixed-and-protected-input-proof"},
    {"id": "quality-is-conjunctive", "statement": "focused recovery cannot hide clean-preservation, false-authority, false-split, latency, RSS, rollback, or per-class regressions", "test_id": "remote-systemic-proof"},
    {"id": "verifier-and-rollback-unchanged", "statement": "the verifier remains the authorization owner and double Shift retains exact rollback", "test_id": "rollback-and-verifier-proof"}
  ],
