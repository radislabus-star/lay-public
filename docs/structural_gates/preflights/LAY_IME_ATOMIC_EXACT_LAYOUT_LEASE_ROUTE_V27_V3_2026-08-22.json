    {"id": "exact-exec-rank-verifier", "from": "transition-decision-core", "relation": "delegates", "to": "transition-verifier", "events": ["exact-lease-preparation"]},
    {"id": "exact-exec-verifier-store", "from": "transition-verifier", "relation": "delegates", "to": "prepared-decision-store", "events": ["exact-lease-preparation"]},

    {"id": "exact-auth-producer-evidence", "from": "exact-layout-producer", "relation": "produces_for", "to": "exact-closed-contour-evidence", "events": ["exact-lease-lifecycle"]},
