      "event": "full-verifier-noapply-preparation",
      "kind": "execution",
      "entry": "printable-input",
      "terminal": "prepared-decision-store",
      "required_roles": ["interface", "orchestrator", "producer", "evidence_owner", "candidate_rank_owner", "authorization_owner"],
      "path_cardinality": [{"from": "printable-input", "to": "prepared-decision-store", "min": 1, "max": 1}]
