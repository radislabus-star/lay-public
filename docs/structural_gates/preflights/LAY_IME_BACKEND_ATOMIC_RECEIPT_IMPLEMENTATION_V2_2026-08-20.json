      "comparison": "transaction id, input-context identity and event identity are byte-identical",
      "test_id": "frame-identity-parity"
    },
    {
      "id": "effect-vector-digest",
      "producer": "sealed daemon post-process frame",
      "consumer": "single client batch apply owner",
      "comparison": "operation count, ordered serialized bytes and digest are byte-identical before apply",
      "test_id": "effect-vector-parity"
    },
    {
      "id": "handled-disposition-binding",
      "producer": "complete frame take/apply receipt",
      "consumer": "client key-event handled return",
      "comparison": "handled true exists only for the same successfully taken complete frame identity",
      "test_id": "handled-binding-parity"
    }
  ],
  "invariants": [
    {
      "id": "no-prefix-delivery",
      "statement": "engine error cancellation or queue overflow exposes zero operation prefixes to the client",
      "test_id": "engine-prefix-kill-matrix"
    },
    {
      "id": "one-frame-owner",
      "statement": "one ProcessKeyEvent has at most one collecting or sealed frame and one successful take",
      "test_id": "single-take-state-machine"
    },
    {
      "id": "fetch-failure-is-unhandled",
      "statement": "frame fetch failure applies zero operations and forces the original event unhandled",
      "test_id": "fetch-failure-disposition"
    },
    {
      "id": "whole-frame-overflow",
      "statement": "operation 31 invalidates and discards the complete frame rather than forwarding or truncating it",
      "test_id": "bounded-overflow"
    },
    {
      "id": "installed-runtime-immutable",
      "statement": "all installed IBus and Lay runtime bytes and running processes remain untouched",
      "test_id": "installed-runtime-parity"
    },
    {
      "id": "isolated-session-only",
      "statement": "the proof uses a private dbus-run-session and cannot connect to the live desktop session bus or emit real input",
