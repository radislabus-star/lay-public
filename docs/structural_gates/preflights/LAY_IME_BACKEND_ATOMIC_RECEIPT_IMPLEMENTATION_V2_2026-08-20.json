  "task_id": "LAY_IME_BACKEND_ATOMIC_RECEIPT_IMPLEMENTATION_V2_2026-08-20",
  "tests": [
    {"id": "frame-owner-static-contract", "kind": "static", "expected": "engine error and operation overflow discard a whole private frame"},
    {"id": "client-take-static-contract", "kind": "static", "expected": "complete frame take result controls handled disposition"},
    {"id": "daemon-source-edit-failure", "kind": "fault_injection", "expected": "an interrupted or rejected daemon source edit retains only the isolated diff and cannot build or install"},
    {"id": "client-source-edit-failure", "kind": "fault_injection", "expected": "an interrupted or rejected client source edit retains only the isolated diff and cannot build or install"},
    {"id": "isolated-build-failure", "kind": "fault_injection", "expected": "a failed isolated build retains its log and writes no installed path"},
    {"id": "frame-identity-parity", "kind": "parity", "expected": "daemon and client frame identities match for every case"},
    {"id": "effect-vector-parity", "kind": "parity", "expected": "ordered effect bytes and digest match before apply"},
    {"id": "handled-binding-parity", "kind": "parity", "expected": "handled true has one matching complete apply receipt"},
    {"id": "engine-prefix-kill-matrix", "kind": "fault_injection", "expected": "every engine kill prefix yields zero client effects and one unhandled original event"},
    {"id": "single-take-state-machine", "kind": "fault_injection", "expected": "duplicate and stale frame take are rejected"},
    {"id": "fetch-failure-disposition", "kind": "fault_injection", "expected": "fetch failure yields zero effects and unhandled original event"},
    {"id": "bounded-overflow", "kind": "fault_injection", "expected": "30 operations are bounded; operation 31 discards the complete frame"},
    {"id": "isolated-build", "kind": "integration", "expected": "exact Ubuntu source builds outside installed paths"},
    {"id": "installed-runtime-parity", "kind": "parity", "expected": "all installed IBus artifact hashes remain byte-identical"},
    {"id": "isolation-scan", "kind": "static", "expected": "proof contains no live session bus, runtime restart, installed write or synthetic input route"}
  ]
}
