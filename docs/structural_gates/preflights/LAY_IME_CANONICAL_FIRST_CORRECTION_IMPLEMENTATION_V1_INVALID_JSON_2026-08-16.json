  "tests": [
    {"id": "proof-route-fault", "kind": "fault_injection", "expected": "an incomplete proof route cannot alter active correction mode or installed runtime"},
    {"id": "fixed-old-new-parity", "kind": "parity", "expected": "old full and canonical-first routes report surfaces, selected verdict, transition proof and safety effect on the same fixed denominator; every divergence is bucketed before promotion"},
    {"id": "canonical-ready-single-decision", "kind": "integration", "expected": "a verified canonical decision executes one DecisionCore readout and does not execute deterministic candidate birth"},
    {"id": "canonical-no-decision-fallback", "kind": "integration", "expected": "canonical no-decision, tied, abstain or unavailable executes the complete deterministic fallback and the common DecisionCore"},
    {"id": "false-authority-zero", "kind": "quality", "expected": "canonical-first adds no false singleton or false authority on the fixed aggregate proof"},
    {"id": "aggregate-restoration-contract", "kind": "quality", "expected": "every required restoration class remains unique top-1 above 95 percent and clean preservation plus lattice coverage do not regress"},
    {"id": "active-mode-fault", "kind": "fault_injection", "expected": "package, service or field failure reaches deterministic fallback without mutation-authority leakage"},
    {"id": "release-cold-latency", "kind": "integration", "expected": "canonical-ready cold first-touch correction finishes inside the unchanged 8 ms lease budget on the fixed boundary denominator"},
    {"id": "fixed-immediate-space-replay", "kind": "integration", "expected": "warmup and eligible GTK outputs are exact, every eligible boundary is Applied, NotReady is zero, and no late edit occurs"},
    {"id": "double-shift-rollback", "kind": "integration", "expected": "autocorrection followed by double Shift restores the exact original token"},
    {"id": "staged-replay-fault", "kind": "fault_injection", "expected": "any staging or replay failure restores exact 1.0.33 engine bytes without restarting global IBus"}
  ],
  "invariants": [
    {"id": "one-rank-owner", "statement": "canonical-ready and fallback branches both terminate at the same DecisionCore and never rank independently", "test_id": "canonical-ready-single-decision"},
    {"id": "fallback-is-complete", "statement": "canonical failure or no-decision cannot suppress deterministic candidate birth", "test_id": "canonical-no-decision-fallback"},
    {"id": "quality-is-conjunctive", "statement": "latency cannot promote a route with any restoration, clean, lattice, false-authority or rollback regression", "test_id": "aggregate-restoration-contract"},
    {"id": "space-budget-unchanged", "statement": "Space waits at most 8 ms and literal fallback never receives a delayed edit", "test_id": "fixed-immediate-space-replay"},
    {"id": "verifier-and-mutator-unchanged", "statement": "the existing verifier remains the authorization owner and committed tail has one mutator", "test_id": "double-shift-rollback"}
