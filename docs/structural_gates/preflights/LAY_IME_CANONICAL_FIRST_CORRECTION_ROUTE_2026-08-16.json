{
  "schema": "nanda.code-route-gate.v2",
  "scope": "design",
  "nodes": [
    {"id": "printable_key", "role": "interface"},
    {"id": "canonical_token_field", "role": "producer"},
    {"id": "pre_rank_completeness", "role": "orchestrator"},
    {"id": "deterministic_fallback", "role": "producer"},
    {"id": "final_candidate_lattice", "role": "evidence_owner"},
    {"id": "decision_core", "role": "candidate_rank_owner"},
    {"id": "correction_lease", "role": "orchestrator"},
    {"id": "transition_verifier", "role": "authorization_owner"},
    {"id": "committed_tail_mutator", "role": "mutation_owner"},
    {"id": "old_full_route_receipt", "role": "producer"},
    {"id": "canonical_first_receipt", "role": "producer"},
    {"id": "parity_comparator", "role": "observer"},
    {"id": "route_proof", "role": "proof_owner"}
  ],
  "edges": [
    {"id": "exec-complete-key-field", "from": "printable_key", "relation": "calls", "to": "canonical_token_field", "events": ["canonical_complete_prepare"]},
    {"id": "exec-complete-field-disposition", "from": "canonical_token_field", "relation": "delegates", "to": "pre_rank_completeness", "events": ["canonical_complete_prepare"]},
    {"id": "exec-complete-disposition-lattice", "from": "pre_rank_completeness", "relation": "delegates", "to": "final_candidate_lattice", "events": ["canonical_complete_prepare"]},
    {"id": "exec-complete-lattice-decision", "from": "final_candidate_lattice", "relation": "delegates", "to": "decision_core", "events": ["canonical_complete_prepare"]},
    {"id": "exec-complete-decision-lease", "from": "decision_core", "relation": "delegates", "to": "correction_lease", "events": ["canonical_complete_prepare"]},
    {"id": "data-complete-field-lattice", "from": "canonical_token_field", "relation": "produces_for", "to": "final_candidate_lattice", "events": ["canonical_complete_prepare"]},
    {"id": "data-complete-lattice-decision", "from": "final_candidate_lattice", "relation": "passes_to", "to": "decision_core", "events": ["canonical_complete_prepare"]},

    {"id": "exec-fallback-key-field", "from": "printable_key", "relation": "calls", "to": "canonical_token_field", "events": ["canonical_incomplete_fallback_prepare"]},
    {"id": "exec-fallback-field-disposition", "from": "canonical_token_field", "relation": "delegates", "to": "pre_rank_completeness", "events": ["canonical_incomplete_fallback_prepare"]},
    {"id": "exec-fallback-disposition-producer", "from": "pre_rank_completeness", "relation": "delegates", "to": "deterministic_fallback", "events": ["canonical_incomplete_fallback_prepare"]},
    {"id": "exec-fallback-producer-lattice", "from": "deterministic_fallback", "relation": "delegates", "to": "final_candidate_lattice", "events": ["canonical_incomplete_fallback_prepare"]},
    {"id": "exec-fallback-lattice-decision", "from": "final_candidate_lattice", "relation": "delegates", "to": "decision_core", "events": ["canonical_incomplete_fallback_prepare"]},
    {"id": "exec-fallback-decision-lease", "from": "decision_core", "relation": "delegates", "to": "correction_lease", "events": ["canonical_incomplete_fallback_prepare"]},
    {"id": "data-fallback-canonical-producer", "from": "canonical_token_field", "relation": "produces_for", "to": "deterministic_fallback", "events": ["canonical_incomplete_fallback_prepare"]},
    {"id": "data-fallback-producer-lattice", "from": "deterministic_fallback", "relation": "produces_for", "to": "final_candidate_lattice", "events": ["canonical_incomplete_fallback_prepare"]},
    {"id": "data-fallback-lattice-decision", "from": "final_candidate_lattice", "relation": "passes_to", "to": "decision_core", "events": ["canonical_incomplete_fallback_prepare"]},

    {"id": "exec-space-lease-verifier", "from": "correction_lease", "relation": "delegates", "to": "transition_verifier", "events": ["space_ready_apply"]},
    {"id": "exec-space-verifier-mutator", "from": "transition_verifier", "relation": "delegates", "to": "committed_tail_mutator", "events": ["space_ready_apply"]},
    {"id": "authority-space-verifier-mutator", "from": "transition_verifier", "relation": "authorizes", "to": "committed_tail_mutator", "events": ["space_ready_apply"]},

    {"id": "observe-old-route", "from": "old_full_route_receipt", "relation": "observes", "to": "parity_comparator", "events": ["old_full_route_observation"]},
    {"id": "observe-new-route", "from": "canonical_first_receipt", "relation": "observes", "to": "parity_comparator", "events": ["canonical_first_observation"]},
    {"id": "prove-parity", "from": "parity_comparator", "relation": "proves", "to": "route_proof", "events": ["route_parity_proof"]}
  ],
  "routes": [
    {
      "id": "canonical-complete-execution",
      "event": "canonical_complete_prepare",
      "kind": "execution",
      "entry": "printable_key",
      "terminal": "correction_lease",
      "required_roles": ["interface", "producer", "orchestrator", "evidence_owner", "candidate_rank_owner"],
      "path_cardinality": [
        {"from": "printable_key", "to": "pre_rank_completeness", "min": 1, "max": 1},
        {"from": "printable_key", "to": "deterministic_fallback", "min": 0, "max": 0},
        {"from": "printable_key", "to": "decision_core", "min": 1, "max": 1},
        {"from": "printable_key", "to": "correction_lease", "min": 1, "max": 1}
      ]
    },
    {
      "id": "canonical-complete-authority",
      "event": "canonical_complete_prepare",
      "kind": "authority",
      "entry": "canonical_token_field",
      "terminal": "decision_core",
      "required_roles": ["producer", "evidence_owner", "candidate_rank_owner"]
    },
    {
      "id": "canonical-fallback-execution",
      "event": "canonical_incomplete_fallback_prepare",
      "kind": "execution",
      "entry": "printable_key",
      "terminal": "correction_lease",
      "required_roles": ["interface", "producer", "orchestrator", "evidence_owner", "candidate_rank_owner"],
      "path_cardinality": [
        {"from": "printable_key", "to": "pre_rank_completeness", "min": 1, "max": 1},
        {"from": "printable_key", "to": "deterministic_fallback", "min": 1, "max": 1},
        {"from": "printable_key", "to": "decision_core", "min": 1, "max": 1},
        {"from": "printable_key", "to": "correction_lease", "min": 1, "max": 1}
      ]
    },
    {
      "id": "canonical-fallback-authority",
      "event": "canonical_incomplete_fallback_prepare",
      "kind": "authority",
      "entry": "canonical_token_field",
      "terminal": "decision_core",
      "required_roles": ["producer", "evidence_owner", "candidate_rank_owner"]
    },
    {
      "id": "space-ready-execution",
      "event": "space_ready_apply",
      "kind": "execution",
      "entry": "correction_lease",
      "terminal": "committed_tail_mutator",
      "required_roles": ["orchestrator", "authorization_owner", "mutation_owner"],
      "path_cardinality": [
        {"from": "correction_lease", "to": "committed_tail_mutator", "min": 1, "max": 1}
      ]
    },
    {
      "id": "space-ready-authority",
      "event": "space_ready_apply",
      "kind": "authority",
      "entry": "transition_verifier",
      "terminal": "committed_tail_mutator",
      "required_roles": ["authorization_owner", "mutation_owner"]
    },
    {
      "id": "old-route-observation",
      "event": "old_full_route_observation",
      "kind": "observation",
      "entry": "old_full_route_receipt",
      "terminal": "parity_comparator",
      "required_roles": ["producer", "observer"]
    },
    {
      "id": "canonical-first-observation",
      "event": "canonical_first_observation",
      "kind": "observation",
      "entry": "canonical_first_receipt",
      "terminal": "parity_comparator",
      "required_roles": ["producer", "observer"]
    },
    {
      "id": "route-parity-proof",
      "event": "route_parity_proof",
      "kind": "proof",
      "entry": "parity_comparator",
      "terminal": "route_proof",
      "required_roles": ["observer", "proof_owner"]
    }
  ]
}
