  "tests": [
    {
      "id": "same-target-suppressed-after-continuation",
      "kind": "parity",
      "expected": "typing another grapheme instead of Tab suppresses the previously shown full target for the current token"
    },
    {
      "id": "alternative-target-retained",
      "kind": "unit",
      "expected": "suppressing one declined target does not suppress a different candidate surface"
    },
    {
      "id": "feedback-remains-censored",
      "kind": "parity",
      "expected": "the first visible prediction remains available for boundary feedback and missing Tab does not become negative evidence"
    },
    {
      "id": "tab-authority-unchanged",
      "kind": "parity",
      "expected": "candidate filtering cannot mutate text and explicit Tab still uses the existing verifier route"
    },
    {
      "id": "proof-failure-prevents-runtime-change",
      "kind": "fault_injection",
      "expected": "a failed source proof leaves the installed engine and global ibus-daemon unchanged"
    }
  ],
  "invariants": [
    {
      "id": "manual-continuation-declines-target",
      "statement": "a full target shown for an earlier prefix cannot immediately reappear after the user continues typing instead of pressing Tab",
      "test_id": "same-target-suppressed-after-continuation"
    },
    {
      "id": "decline-is-target-specific",
      "statement": "decline suppression is exact-surface scoped and leaves alternative surfaces eligible",
      "test_id": "alternative-target-retained"
    },
    {
      "id": "observation-is-not-authority",
      "statement": "the retained observation supports censored boundary feedback but cannot restore a declined display target",
      "test_id": "feedback-remains-censored"
    },
    {
      "id": "mutation-authority-stable",
      "statement": "display suppression neither authorizes nor performs an edit",
      "test_id": "tab-authority-unchanged"
