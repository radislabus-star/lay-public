  "tests": [
    {"id": "partial-adapter-migration-fault", "kind": "fault_injection", "expected": "a missing or lossy adapter fails compile/parity while installed runtime, rank, display, cache, mutation and verifier remain byte-identical"},
    {"id": "target-evidence-layout-budget", "kind": "integration", "expected": "TargetWitnessV1 is at most 24 bytes, TargetEvidenceSetV1 at most 128 bytes, targets are at most 74, witnesses at most 4, new retained evidence at most 12288 bytes per field, 160-entry delta at most 1966080 bytes and process RSS delta at most 5 MiB"},
    {"id": "witness-merge-permutation-parity", "kind": "parity", "expected": "all producer orders and provenance aliases produce the same semantic evidence roots, bounded provenance annotations, overflow digest and evidence hash"},
    {"id": "legacy-evidence-roundtrip", "kind": "parity", "expected": "every legacy evidence enum maps to the common type and back without changing None, relation, grounding, provenance annotation or display projection"},
    {"id": "slice1-semantic-output-parity", "kind": "integration", "expected": "fixed diagnostics and event manifests preserve exact candidate surfaces, order, gate actions, verdicts, mutations and feedback because Slice 1 changes vocabulary only"},
    {"id": "slice1-route-parity", "kind": "parity", "expected": "current observed source route cardinality and every display, Tab, Space, stale and rollback owner remain unchanged in Slice 1"},
    {"id": "prepared-material-identity-parity", "kind": "parity", "expected": "producer and every adapter agree on normalization profile, material target, semantic root, package generation, completeness and schema identities"},
    {"id": "frame-values-not-cacheable", "kind": "parity", "expected": "replacement span, focus, tail epoch, context, frame rejection, selected winner and authority certificate cannot be constructed inside PreparedTargetMaterialV1"},
    {"id": "completeness-roundtrip", "kind": "parity", "expected": "Complete, Overflow and Failed states plus counts and order-independent digests survive every Slice 1 adapter without changing current behavior"}
  ],
  "invariants": [
    {"id": "one-common-evidence-owner", "statement": "src/typing_transition/target_evidence.rs is the only owner of the new vocabulary", "test_id": "legacy-evidence-roundtrip"},
