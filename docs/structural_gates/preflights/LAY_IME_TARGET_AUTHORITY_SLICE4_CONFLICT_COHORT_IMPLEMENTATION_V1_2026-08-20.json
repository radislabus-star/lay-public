  "tests": [
    {"id": "footprint-frame-parity", "kind": "parity", "expected": "same exact frame target produces the same exact footprint"},
    {"id": "footprint-frame-fault", "kind": "fault_injection", "expected": "stale frame span or source snapshot aborts conflict construction"},
    {"id": "duplicate-root-permutation-parity", "kind": "parity", "expected": "duplicate output aliases merge semantic roots without producer votes"},
    {"id": "cohort-truth-table", "kind": "unit", "expected": "zero one many complete and incomplete members map exactly to Winner Tied or Abstain"},
    {"id": "cohort-settlement-parity", "kind": "parity", "expected": "same complete component state and preservation evidence produce the same verdict"},
    {"id": "cohort-settlement-fault", "kind": "fault_injection", "expected": "missing completeness or preservation input aborts shadow settlement without live output"},
    {"id": "cohort-permutation-parity", "kind": "parity", "expected": "all input permutations produce identical ordered members hash and verdict"},
    {"id": "candidate-state-preservation", "kind": "parity", "expected": "cohort construction does not mutate Born Grounded or Rejected"},
    {"id": "born-conflict-fault", "kind": "fault_injection", "expected": "one Grounded plus one conflicting Born cannot issue Winner"},
    {"id": "rejected-exclusion", "kind": "unit", "expected": "Rejected is excluded from grounded tie membership"},
    {"id": "whole-field-incomplete-fault", "kind": "fault_injection", "expected": "field overflow or failure yields incomplete Tied or Abstain never Winner"},
    {"id": "narrow-scope-proof-fault", "kind": "fault_injection", "expected": "unproved narrow scope fails closed"},
    {"id": "preservation-veto", "kind": "fault_injection", "expected": "Preserve original yields Abstain PreserveOriginal before Winner"},
    {"id": "multiple-component-fault", "kind": "fault_injection", "expected": "two independent components yield Abstain MultipleEditComponents"},
    {"id": "cohort-input-scan", "kind": "integration", "expected": "cohort settlement accepts no context score rank L3 or L4 input"},
    {"id": "fixed-conflict-cohort-shadow-proof", "kind": "integration", "expected": "fixed 13x100 reports deterministic cohorts zero false singleton zero incomplete Winner and zero lost grounded target"},
    {"id": "live-route-semantic-parity", "kind": "parity", "expected": "shadow-disabled live semantic output and authority remain exact"},
    {"id": "systemic-runtime-source-scan", "kind": "integration", "expected": "changed source has no literal case deployment package write certificate or live owner callsite"}
  ]
