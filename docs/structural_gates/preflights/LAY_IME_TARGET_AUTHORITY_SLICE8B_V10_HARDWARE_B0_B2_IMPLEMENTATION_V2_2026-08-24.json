  "tests": [
    {
      "id": "implementation-route-fault",
      "kind": "fault_injection",
      "expected": "a missing owner binding, undeclared write path or forbidden route leaves no remote output root and cannot invoke Cargo, perf or a subject"
    },
    {
      "id": "b0a-input-closure-parity",
      "kind": "parity",
      "expected": "all P0 and correction manifests verify; every copied input records source and destination path, mode, bytes and SHA-256; remote V13 is copied to a read-only B-specific closure and active installed paths remain unchanged"
    },
    {
      "id": "b0a-publication-fault",
      "kind": "fault_injection",
      "expected": "missing input, wrong byte, mode, Build ID, host, output collision or package SHA leaves no B0a final path, removes only unpublished staging and leaves the one-build marker unused"
    },
    {
      "id": "remote-host-toolchain-parity",
      "kind": "parity",
      "expected": "hostname and machine-id digest match; Cargo, rustc, LLVM, x86_64 target, release profile, empty RUSTFLAGS and default features match before build admission"
    },
    {
      "id": "remote-cargo-guard-parity",
      "kind": "parity",
      "expected": "the staged guard is mode 0775 and SHA-256 a5b01f9a12b32ee2bcfc957a5e9f65efb52fe6e7644850ae3f00e412648243fe; status passes and free space exceeds the 12 GiB target budget plus isolated artifact headroom before consuming the build marker"
    },
    {
      "id": "production-prefix-and-test-module-parity",
      "kind": "parity",
      "expected": "lines 1 through 1148 are exactly 39047 bytes with SHA-256 ce9ea2d290602774e2f45444e10e6fdabce6af4a61ae2bdca54c6d2e31a53f26 and all additions are cfg(test)-only with no production hook"
    },
    {
      "id": "diagnostic-build-fault",
      "kind": "fault_injection",
      "expected": "pre-Cargo fault injection over copies of real sealed inputs proves the one-build marker remains consumed and no final executable appears; any real Cargo or identity failure retains logs and forbids retry under V1"
    },
    {
      "id": "one-build-marker-and-executable-parity",
      "kind": "parity",
      "expected": "exactly one cargo-guard process group produces one executable identity containing freezer, parity, B5 and B6 test-only entrypoints; source inventory, patch, final source, ELF SHA-256 and Build ID are sealed before publication"
    },
    {
      "id": "schedule-freezer-fault",
      "kind": "fault_injection",
      "expected": "a pre-exec or staged-output fault leaves no B0b schedule, preserves the consumed freezer marker and executable identity, and forbids freezer retry or rebuild under V1"
    },
    {
      "id": "freezer-schedule-parity-and-target-absence",
      "kind": "parity",
      "expected": "one unmeasured run emits 382 ordered unique composite identities and exact retrieval-lane digests with fixed B5 and B6 assignments; schema and recursive key scan find no target surface or target-derived value"
    },
    {
      "id": "b0b-publication-fault",
      "kind": "fault_injection",
      "expected": "wrong count, duplicate identity, digest mismatch, target leak, wrong executable identity or destination collision leaves no B0b final path and cannot rerun build or freezer"
    },
    {
      "id": "b0b-publication-and-identity-parity",
      "kind": "parity",
      "expected": "B0b independently validates all bindings, creates hashes and read-only modes in staging, then performs one final same-filesystem rename with zero post-rename mutation"
    },
    {
      "id": "atomic-publication-faults",
      "kind": "fault_injection",
      "expected": "faults before each B0a, executable-provenance or B0b final rename never expose a partial final tree; a successful rename is the last mutating operation"
    },
    {
      "id": "owner-capability-separation",
      "kind": "integration",
      "expected": "static command allowlists and receipts prove four separate B0 owners and the exact B0a to build to freezer to B0b to B1 to B2 sequence"
    },
    {
      "id": "full-source-closure-watch-label",
      "kind": "parity",
      "expected": "every executable and receipt says V10-derived diagnostic executor proxy and SURVIVING_REMOTE_BYTES_NOT_BUILD_TIME_SNAPSHOT; no claim upgrades full historical source closure above WATCH"
    },
    {
      "id": "b1-environment-blocking-fault",
      "kind": "fault_injection",
      "expected": "host identity mismatch, pressure, temperature, throttle, process conflict, policy drift or timeout produces BLOCKED_ENVIRONMENT without tuning the host or invoking perf"
    },
    {
      "id": "b1-b2-environment-parity",
      "kind": "parity",
      "expected": "frozen topology, boot, kernel, microcode, SMT, NUMA, cache, governor, EPP, turbo and P-state fields match before and after both benign probes"
    },
    {
      "id": "b2-benign-workload-parity",
      "kind": "parity",
      "expected": "the exact remote yes, taskset and perf bytes are recorded and one selected P-core plus all 20 mapped CPUs execute only the benign yes workload with output to /dev/null"
    },
    {
      "id": "b2-pmu-capability-fault",
      "kind": "fault_injection",
      "expected": "unsupported, uncounted, scaled, multiplexed, substituted, missing hybrid coverage, wrong privilege, inheritance/control failure or time_running mismatch produces BLOCKED_PMU and no later subject run"
    },
    {
      "id": "b2-benign-capability-boundary",
      "kind": "integration",
      "expected": "B2 records exact perf and PMU identities, selectors, privilege, inheritance, control and per-thread support for G0 through G3 without loading V13 or executing historical V10, the proxy, search enumeration or latency measurement"
    },
    {
      "id": "runtime-noninterference",
      "kind": "parity",
      "expected": "installed Lay bytes, packages, authority configuration and executable paths remain unchanged; no daemon, IBus or extension restart and no package rebuild or install occurs"
    },
    {
      "id": "later-gate-absence",
      "kind": "integration",
      "expected": "process audit and receipts show zero B3, proxy parity, B5, B6, predictive-model, V12, push or deployment action; the successful terminal says later gates not admitted"
    },
    {
      "id": "forbidden-route-source-scan",
      "kind": "integration",
      "expected": "new controller, patch and scripts contain no undeclared output, adaptive build, retry, target schedule field, production hook, system-wide perf, event substitution, host tuning, deployment, authority or V12 route"
    },
    {
      "id": "owning-document-result",
      "kind": "integration",
      "expected": "the owning architecture records each executed B0 through B2 step, measured facts, failures, untested scope, exact receipt paths, full source closure WATCH and runtime_authority_changed=false"
    },
    {
      "id": "preflight-revision-provenance",
      "kind": "parity",
      "expected": "V1 manifest remains SHA-256 c04ee81fd2e5c65faf48e18e533cdff3f8cb35fe3cb19b4116c4595c4115e515 and its BLOCKED_BEFORE_CODE receipt remains SHA-256 740bd6732a13d72e6aa07829eb841b18e873ec236ca1fbc3b863bc093a628b43"
    }
  ]
}
