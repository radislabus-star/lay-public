    {"id": "direct-slot-fault-matrix", "kind": "fault_injection", "expected": "short write alignment unsupported-direct checksum generation and durability failures are fail-closed"},
    {"id": "ring-wrap-recovery", "kind": "parity", "expected": "capacity wrap recovers only the latest complete contiguous slot and logical-record chain"},
    {"id": "prepare-failure", "kind": "fault_injection", "expected": "prepare append or sync failure returns pre-effect refusal and no effect eligibility"},
    {"id": "co-commit-order", "kind": "parity", "expected": "one barrier durably commits terminal N and Prepared N+1 before either dependent state is released"},
    {"id": "barrier-count", "kind": "integration", "expected": "each steady-state event reports no more than one independent foreground durability wait"},
    {"id": "tail-flush-order", "kind": "integration", "expected": "idle terminal becomes publishable only after bounded tail flush durability"},
    {"id": "fault-matrix", "kind": "fault_injection", "expected": "append sync checksum saturation disconnect and owner-stop failures are fail-closed"},
    {"id": "side-effect-scan", "kind": "integration", "expected": "microproof contains no text layout key service package or network mutation"},
    {"id": "local-durability-microproof", "kind": "fault_injection", "expected": "one local ext4 NVMe direct-slot proof has prepare and co-commit p99 <=2 ms max <8 ms with prepare co-commit tail native-wait wrap saturation and persistence-failure strata reported"}
