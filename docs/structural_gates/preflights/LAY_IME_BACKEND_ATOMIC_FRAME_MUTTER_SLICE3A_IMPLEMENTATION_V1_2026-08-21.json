  "tests": [
    {"id": "source-scope-fault-policy", "kind": "fault_injection", "expected": "partial source failure is retained without editing native owner or installed files"},
    {"id": "remote-capacity-gate", "kind": "runtime_health", "expected": "20 logical CPUs are visible and no competing heavy task is present before build"},
    {"id": "remote-sync-fault-policy", "kind": "fault_injection", "expected": "sync failure affects only the task-owned remote sandbox"},
    {"id": "remote-build-fault-policy", "kind": "fault_injection", "expected": "build failure terminates only the remote task group and never triggers local build"},
    {"id": "normal-proof-fault-policy", "kind": "fault_injection", "expected": "any normal proof failure retains logs and blocks promotion"},
    {"id": "sanitized-proof-fault-policy", "kind": "fault_injection", "expected": "any ASan UBSan or LSan finding blocks promotion"},
    {"id": "evidence-write-fault-policy", "kind": "fault_injection", "expected": "missing paper or receipt prevents a Slice 3A PASS claim"},
    {"id": "ibus-mutter-wire-parity", "kind": "parity", "expected": "IBus-produced canonical and malformed fixtures receive exact matching Mutter decode verdicts"},
    {"id": "focus-lineage-parity", "kind": "parity", "expected": "query and submit bind the exact current focus identity and lineage"},
    {"id": "native-epoch-parity", "kind": "fault_injection", "expected": "current epoch is accepted once; stale duplicate future and zero epochs emit zero fake effects"},
    {"id": "focus-bound-replay-parity", "kind": "parity", "expected": "same-focus replay preserves the copied key exactly once and stale-focus replay is refused"},
    {"id": "default-profile-unsupported", "kind": "unit", "expected": "base and production focus classes expose no atomic profile in Slice 3A"},
    {"id": "complete-vector-admission", "kind": "exhaustive_unit", "expected": "only frozen canonical vectors reach the fake focus and every malformed vector emits zero fake effects"},
    {"id": "single-frame-call", "kind": "unit", "expected": "each admitted frame invokes one fake focus apply call and returns one terminal result"},
    {"id": "focus-change-fault-matrix", "kind": "fault_injection", "expected": "focus change at every validation boundary yields zero frame and replay effects"},
    {"id": "legacy-clutter-parity", "kind": "regression", "expected": "existing Clutter input method tests and focused baseline cases remain PASS"},
    {"id": "slice3a-source-allowlist", "kind": "static", "expected": "only declared Clutter API validator test and Meson files differ; MetaWayland GNOME Shell IBus Lay and installed bytes are unchanged"},
    {"id": "remote-only-build-receipt", "kind": "parity", "expected": "receipt names e@192.168.3.94 compiler commands source hashes and zero local build process"}
  ]
