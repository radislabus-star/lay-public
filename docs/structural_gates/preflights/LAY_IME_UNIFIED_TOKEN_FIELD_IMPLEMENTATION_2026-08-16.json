  "tests": [
    {"id":"live-owner-benchmark-route-binding","kind":"parity","expected":"the benchmark calls the same Productive V90 field producer as canonical text and IME projections, reports cold separately, and repeats in one process"},
    {"id":"field-materialization-parity","kind":"parity","expected":"old direct readout and immutable-field materialization have identical candidates, evidence, authority, availability and safety effects on the fixed corpus"},
    {"id":"single-flight-one-producer","kind":"integration","expected":"two simultaneous typed projections for one CanonicalTokenKey execute Productive V90 exactly once and both receive the same immutable field"},
    {"id":"single-flight-transient-failure","kind":"fault_injection","expected":"a transient L1/package/readout failure wakes all waiters, is not cached as lexical truth and leaves no stranded Computing entry"},
    {"id":"package-generation-supersession","kind":"fault_injection","expected":"reload invalidates ready entries and an old in-flight generation cannot publish into the new generation"},
    {"id":"gui-identity-and-event-order","kind":"integration","expected":"one InputFrameIdentity feeds both typed projections, correction is scheduled before display, and display cancellation cannot invalidate a matching correction lease"},
    {"id":"space-lease-single-consumer","kind":"integration","expected":"Space takes one exact matching lease before display boundary close; stale or absent leases commit one literal Space and never apply late"},
    {"id":"trace-cardinality-and-route-proof","kind":"integration","expected":"trace reports one field producer per key plus typed projection and lease outcomes; observed route gate has one mutation and verifier owner"},
    {"id":"candidate-quality-and-authority-parity","kind":"parity","expected":"fixed correction and IME suites preserve surfaces, verdicts, false applies, unsafe edits and double-Shift rollback contract"},
    {"id":"remote-source-parity","kind":"parity","expected":"isolated remote source snapshot equals local planned source bytes and all Cargo work uses scripts/cargo-guard.sh"},
    {"id":"managed-runtime-deployment-continuity","kind":"integration","expected":"new managed binaries start with Productive ready_live_owner, package SHA unchanged, global ibus-daemon PID unchanged and rollback restores 1.0.33"},
    {"id":"field-projection-identity-parity","kind":"parity","expected":"display and correction consumers receive the exact same field generation and CanonicalTokenKey"},
    {"id":"gui-frame-identity-parity","kind":"parity","expected":"display work and correction work carry byte-equal structural InputFrameIdentity values captured from one event"},
    {"id":"remote-install-binary-parity","kind":"parity","expected":"every installed managed binary equals the remote release artifact by SHA-256"},
    {"id":"benchmark-failure-preserves-runtime","kind":"fault_injection","expected":"a benchmark build or execution failure leaves installed binaries, model packages and managed processes unchanged"},
    {"id":"slice1-failure-preserves-runtime","kind":"fault_injection","expected":"a field extraction or parity failure changes no installed runtime and preserves the Slice 0 receipt"},
    {"id":"slice2-failure-preserves-runtime","kind":"fault_injection","expected":"a single-flight concurrency or cleanup failure changes no installed runtime, strands no Computing entry and preserves the Slice 0 receipt"},
    {"id":"slice3-failure-preserves-runtime","kind":"fault_injection","expected":"an identity or event-order failure changes no installed runtime and leaves no new persistent state"},
    {"id":"slice4-failure-preserves-runtime","kind":"fault_injection","expected":"an observability or route-proof failure changes no installed runtime and retains its failed receipt"},
    {"id":"deployment-failure-rolls-back","kind":"fault_injection","expected":"any install, startup or continuity failure restores the full 1.0.33 snapshot while global IBus and Productive package bytes remain unchanged"}
  ],
  "invariants": [
    {"id":"one-expensive-field-owner","statement":"display and correction projections share one immutable Productive V90 computation for the same CanonicalTokenKey","test_id":"single-flight-one-producer"},
    {"id":"projection-does-not-own-mutation","statement":"the cached field contains L1.1 and L2 evidence only; L3, L4, AuthorizedEdit, display feedback and mutation state remain request-time","test_id":"field-materialization-parity"},
    {"id":"failures-are-not-lexical-truth","statement":"transient field failures are removed after waking waiters and are never retained as candidate evidence","test_id":"single-flight-transient-failure"},
    {"id":"generation-isolation","statement":"package reload clears ready entries and supersedes old in-flight publications","test_id":"package-generation-supersession"},
    {"id":"ibus-thread-is-nonblocking","statement":"printable and Space IBus handlers schedule or consume bounded products and never construct Productive V90 synchronously","test_id":"gui-identity-and-event-order"},
    {"id":"space-is-one-shot","statement":"a correction lease is exact-identity single-consumer and no late correction follows literal-Space fallback","test_id":"space-lease-single-consumer"},
    {"id":"verifier-monopoly-preserved","statement":"TransitionDecisionCore and the structural verifier remain the only final ranking and edit authorization path","test_id":"trace-cardinality-and-route-proof"},
    {"id":"packages-remain-byte-identical","statement":"the unified field refactor changes no L1.1, canonical L2, Productive p2m or recovery p2r bytes","test_id":"managed-runtime-deployment-continuity"}
  ],
