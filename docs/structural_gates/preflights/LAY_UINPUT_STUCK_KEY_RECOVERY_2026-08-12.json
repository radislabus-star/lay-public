  "tests": [
    {
      "id": "tap-frame-unit",
      "kind": "unit",
      "expected": "every unshifted frame is down then up and every shifted frame closes key and Shift in one frame"
    },
    {
      "id": "emit-failure-releases-all",
      "kind": "fault_injection",
      "expected": "an emit failure triggers a second best-effort frame containing only key-up events for every supported virtual key"
    },
    {
      "id": "producer-consumer-frame-parity",
      "kind": "parity",
      "expected": "the frame produced by Lay is the exact ordered evdev frame consumed by VirtualDevice emit"
    },
