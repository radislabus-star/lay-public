  "identity_contracts": [
    {
      "id": "paired-release-keycode-identity",
      "producer": "Shell SUBMITTED FRAME_READY press keycode stored in the bounded release ledger",
      "consumer": "the next matching physical release consumed at the Shell event boundary",
      "comparison": "the release keycode equals the stored press keycode and consumes exactly one entry",
      "test_id": "paired-release-keycode-parity"
    },
    {
      "id": "paired-receipt-transaction-identity",
      "producer": "Shell paired-submitted prior receipt transaction identity",
      "consumer": "Lay pending FRAME_READY transition and exact speculative handled marker",
      "comparison": "receipt transaction equals pending transaction before only that pending keycode marker is removed",
      "test_id": "paired-receipt-transaction-parity"
    },
    {
      "id": "modifier-route-separation",
      "producer": "physical modifier press and release events",
      "consumer": "unchanged Lay atomic modifier route",
      "comparison": "modifier events never enter the Shell paired ledger and retain exact press/release cardinality",
      "test_id": "modifier-route-parity"
    },
    {
      "id": "remote-source-parity",
      "producer": "local approved Shell, Lay and proof source bytes",
      "consumer": "20-CPU remote proof build inputs",
      "comparison": "exact SHA-256 equality before build",
      "test_id": "remote-source-parity"
    }
  ],
  "runtime_comparisons": [],
  "invariants": [
    {"id": "single-release-owner", "statement": "a paired FRAME_READY non-modifier release is consumed once in Shell with zero Lay RPC and zero native replay", "test_id": "single-release-owner-proof"},
    {"id": "ledger-bounded-and-invalidated", "statement": "the release ledger is bounded by the queue/keycode budget and clears on context or focus invalidation", "test_id": "ledger-boundary-proof"},
    {"id": "receipt-bound-marker-cleanup", "statement": "Lay removes only the exact pending handled marker after a transaction-matched paired-submitted receipt", "test_id": "paired-receipt-transaction-parity"},
    {"id": "modifier-semantics-preserved", "statement": "modifier events bypass the paired ledger so double Shift remains owned by Lay", "test_id": "double-shift-undo-proof"},
    {"id": "mutter-profile-preserved", "statement": "Mutter awaiting-surrounding admission and atomic profile bytes remain unchanged", "test_id": "mutter-profile-parity"},
    {"id": "full-route-contract", "statement": "514 exact press commits and 514 local paired releases pass with zero release RPCs, zero native paired releases, zero legacy mutation calls, p99 at most 5 ms, max below 8 ms and zero leftovers", "test_id": "integrated-v24-full-route"},
    {"id": "runtime-unmodified", "statement": "installed Lay, Mutter and Shell remain byte-identical before deployment preflight", "test_id": "installed-runtime-parity"}
  ],
  "state_machine": {
    "initial_state": "PAPER_APPROVED",
    "steps": [
      {
        "id": "edit-proof-sources",
        "from": "PAPER_APPROVED",
        "to": "SOURCE_EDITED",
        "mutates": true,
        "failure_state": "SOURCE_EDIT_FAILED",
        "cleanup": "restore only the four scoped source/proof files from their pinned baselines",
        "preserves": ["shell-input-owner-bytes", "lay-engine-owner-bytes", "lay-ibus-event-owner-bytes", "mutter-profile-owner-bytes", "installed-lay-preserved", "installed-mutter-preserved", "installed-shell-preserved"],
        "test_id": "source-edit-fault"
      },
      {
        "id": "sync-remote-sources",
        "from": "SOURCE_EDITED",
        "to": "REMOTE_SOURCE_SYNCED",
        "mutates": true,
        "failure_state": "REMOTE_SYNC_FAILED",
        "cleanup": "reject partial or hash-mismatched remote files before any build",
        "preserves": ["mutter-profile-owner-bytes", "installed-lay-preserved", "installed-mutter-preserved", "installed-shell-preserved"],
        "test_id": "remote-sync-fault"
      },
      {
        "id": "build-remote-proof-artifacts",
        "from": "REMOTE_SOURCE_SYNCED",
        "to": "REMOTE_BUILT",
        "mutates": true,
        "failure_state": "REMOTE_BUILD_FAILED",
        "cleanup": "discard only partial remote build outputs and retain source hashes and failure logs",
        "preserves": ["installed-lay-preserved", "installed-mutter-preserved", "installed-shell-preserved"],
        "test_id": "remote-build-fault"
      },
      {
        "id": "run-focused-proofs",
        "from": "REMOTE_BUILT",
        "to": "FOCUSED_PROVEN",
        "mutates": true,
        "failure_state": "FOCUSED_PROOF_FAILED",
        "cleanup": "terminate proof-owned processes and retain complete failed output",
        "preserves": ["installed-lay-preserved", "installed-mutter-preserved", "installed-shell-preserved"],
        "test_id": "focused-proof-fault"
      },
      {
        "id": "run-v24-full-route",
        "from": "FOCUSED_PROVEN",
        "to": "V24_AGGREGATE_PROVEN",
        "mutates": true,
        "failure_state": "FULL_ROUTE_FAILED",
        "cleanup": "terminate proof-owned processes, remove only the proof socket and retain the complete denominator",
        "preserves": ["installed-lay-preserved", "installed-mutter-preserved", "installed-shell-preserved"],
        "test_id": "full-route-fault"
      }
    ],
    "terminal_states": ["V24_AGGREGATE_PROVEN", "SOURCE_EDIT_FAILED", "REMOTE_SYNC_FAILED", "REMOTE_BUILD_FAILED", "FOCUSED_PROOF_FAILED", "FULL_ROUTE_FAILED"]
  },
  "tests": [
    {"id": "source-edit-fault", "kind": "fault_injection", "expected": "failed scoped edit changes no preserved owner or installed runtime"},
    {"id": "remote-sync-fault", "kind": "fault_injection", "expected": "partial or hash-mismatched remote sources are refused before build"},
    {"id": "remote-build-fault", "kind": "fault_injection", "expected": "failed guarded remote build grants no proof or deployment authority"},
    {"id": "focused-proof-fault", "kind": "fault_injection", "expected": "failed focused proof leaves no proof-owned process and retains evidence"},
    {"id": "full-route-fault", "kind": "fault_injection", "expected": "failed full route cleans proof-owned processes and preserves the failed denominator"},
    {"id": "paired-release-keycode-parity", "kind": "parity", "expected": "only an exact matching keycode consumes one ledger entry; a mismatch, duplicate or absent entry consumes none"},
    {"id": "paired-receipt-transaction-parity", "kind": "parity", "expected": "only a transaction-matched paired-submitted receipt removes the exact pending keycode marker before commit"},
    {"id": "modifier-route-parity", "kind": "parity", "expected": "Shift, Control, Alt, Meta, Super, Hyper and lock key events never populate or consume the paired ledger"},
    {"id": "single-release-owner-proof", "kind": "unit", "expected": "a submitted FRAME_READY press consumes its matching release locally with no RPC or native replay"},
    {"id": "ledger-boundary-proof", "kind": "unit", "expected": "ledger capacity is bounded, duplicate press keycodes do not grow it and invalidation clears it"},
    {"id": "double-shift-undo-proof", "kind": "integration", "expected": "autocorrect followed immediately by physical double Shift restores the exact original token"},
    {"id": "mutter-profile-parity", "kind": "parity", "expected": "Mutter atomic profile and awaiting-surrounding owner bytes remain unchanged"},
    {"id": "remote-source-parity", "kind": "parity", "expected": "local and remote approved Shell, Lay and proof source hashes match before guarded builds"},
    {"id": "integrated-v24-full-route", "kind": "integration", "expected": "514 commits, 514 paired local releases, zero release RPCs, zero native paired releases, zero legacy calls, p99 at most 5 ms, max below 8 ms and leftovers 0/0"},
    {"id": "installed-runtime-parity", "kind": "parity", "expected": "installed Lay, Mutter and Shell hashes remain byte-identical before deployment preflight"}
  ]
}
