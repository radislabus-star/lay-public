  "tests": [
    {"id": "generic-identity-roundtrip", "kind": "unit", "expected": "language layout script and geometry identities roundtrip without RU/EN-only branching"},
    {"id": "v1-reader-parity", "kind": "parity", "expected": "installed V1 package decodes to the same profiles counters and shadow recommendation"},
    {"id": "v2-byte-roundtrip", "kind": "parity", "expected": "V2 encode decode encode is byte deterministic and validates symbol references"},
    {"id": "typed-v3-event-parity", "kind": "parity", "expected": "V3 event producer and L4 usage reader agree on every typed scene field"},
    {"id": "legacy-v2-adapter-parity", "kind": "parity", "expected": "valid V2 RU/EN rows remain readable without inventing unsupported language facts"},
    {"id": "scene-encoder-parity", "kind": "parity", "expected": "compiler and runtime produce identical compact scene vectors and fingerprints"},
    {"id": "single-rank-owner", "kind": "parity", "expected": "L4 contributes evidence to one TransitionDecisionCore and never selects or mutates independently"},
    {"id": "complete-episode-only", "kind": "unit", "expected": "only complete causal episodes update signed L4 banks"},
    {"id": "source-failure-has-no-runtime-effect", "kind": "fault_injection", "expected": "failed source checks leave installed binaries services journals and V1 package unchanged"},
    {"id": "candidate-build-fault-preserves-v1", "kind": "fault_injection", "expected": "truncated or corrupt candidate V2 package is removed and V1 stays byte-identical"},
    {"id": "runtime-continuity", "kind": "integration", "expected": "global IBus and managed input engine remain running and V1 remains the live authority"}
  ],
  "invariants": [
    {"id": "identity-domains-separate", "statement": "language layout script and physical geometry remain separate typed identities", "test_id": "generic-identity-roundtrip"},
    {"id": "old-packages-readable", "statement": "V2 implementation preserves exact V1 read behavior", "test_id": "v1-reader-parity"},
    {"id": "journal-prefix-immutable", "statement": "migration emits a V3 suffix and never rewrites existing V1 or V2 rows", "test_id": "typed-v3-event-parity"},
    {"id": "one-live-decision-owner", "statement": "L4 is an evidence producer and TransitionDecisionCore remains the only candidate rank owner", "test_id": "single-rank-owner"},
    {"id": "causal-learning-only", "statement": "censored transport and incomplete episodes never become negative or positive L4 evidence", "test_id": "complete-episode-only"},
    {"id": "publication-is-transactional", "statement": "a later deployment must publish package state and its applied segment checkpoint in one atomic artifact", "test_id": "candidate-build-fault-preserves-v1"}
