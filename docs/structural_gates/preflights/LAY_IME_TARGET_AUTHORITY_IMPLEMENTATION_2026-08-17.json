  "tests": [
    {"id": "target-evidence-migration-fault", "kind": "fault_injection", "expected": "partial enum conversion fails compile or semantic parity while installed 1.0.33 remains unchanged"},
    {"id": "authority-derivation-fault", "kind": "fault_injection", "expected": "missing relation, target grounding, geometry, cohort or contradiction data produces Rejected or NeedsContext, never a singleton authority"},
    {"id": "boundary-internalization-fault", "kind": "fault_injection", "expected": "one-sided grounding, changed letters, stale context or whole-token conflict prevents Boundary certification and cannot invoke the removed parallel route"},
    {"id": "evidence-roundtrip-parity", "kind": "parity", "expected": "L2ImeTargetEvidence, ReplacementTargetEvidence and UnifiedCorrectionCandidate adapters preserve exact target relation and never promote None"},
    {"id": "candidate-state-table", "kind": "parity", "expected": "Born, Grounded, L2Certified, NeedsContext and Rejected follow the paper truth table for every operator class"},
    {"id": "stage-denominator-proof", "kind": "integration", "expected": "every case records admission, birth, retention, certificate, selection and verifier outcomes without changing the denominator"},
    {"id": "focused-correction-36", "kind": "integration", "expected": "full fixed canonical correction gate passes 36 of 36 and focused and concurrent runs agree"},
    {"id": "boundary-positive-and-false-split", "kind": "integration", "expected": "true split and merge recall are reported separately and false authority and false split remain zero"},
    {"id": "cache-generation-parity", "kind": "parity", "expected": "target evidence schema, ordered L1.1 lattice, contours, scene and all package hashes participate in cache identity; stale publication is rejected"},
    {"id": "single-owner-route-proof", "kind": "parity", "expected": "observed source and runtime trace have one typed field, one candidate-specific readout, one DecisionCore, one verifier and one mutator with no parallel Boundary owner"},
    {"id": "remote-conjunctive-proof", "kind": "integration", "expected": "remote guarded proof passes every L1 class above 95 percent plus clean preservation, lattice coverage, false certainty, package, RSS, latency and all correction-route safety denominators"},
    {"id": "hot-path-and-space-proof", "kind": "integration", "expected": "printable and Space IBus threads perform no heavy synchronous field work, Space consumes only an exact ready lease and emits exactly one separator"},
    {"id": "rollback-and-verifier-proof", "kind": "parity", "expected": "unchanged transition and backend verification remain fail-closed and immediate double Shift restores the exact pre-autocorrection token"}
  ],
  "invariants": [
    {"id": "authority-is-target-specific", "statement": "authority is derived from relation, target grounding, geometry, cohort and contradictions for one observed-target pair", "test_id": "candidate-state-table"},
    {"id": "context-does-not-create-lexical-proof", "statement": "L3 and L4 may select among grounded compatible targets but cannot birth, ground or resurrect a target", "test_id": "candidate-state-table"},
    {"id": "boundary-is-one-field-hypothesis", "statement": "Boundary split and merge compete with whole-token targets before certificate issuance and have no independent Eligible route", "test_id": "boundary-positive-and-false-split"},
    {"id": "grounded-l11-target-retained", "statement": "a grounded L1.1 candidate remains in the bounded lattice unless explicit independently measured contradiction rejects it", "test_id": "stage-denominator-proof"},
    {"id": "one-authority-route", "statement": "one event has one evidence owner, one DecisionCore, one verifier and one mutator", "test_id": "single-owner-route-proof"},
    {"id": "cache-never-owns-authority", "statement": "cache stores immutable material only and cannot retain a selected winner, context result, lease or AuthorizedEdit", "test_id": "cache-generation-parity"},
    {"id": "quality-is-conjunctive", "statement": "focused recovery cannot hide per-class, preservation, coverage, false-certainty, boundary, package, RSS, latency or rollback regressions", "test_id": "remote-conjunctive-proof"},
    {"id": "hot-input-never-waits-for-field", "statement": "printable and Space handlers never synchronously compute or unboundedly wait for L1.1 or Productive V90", "test_id": "hot-path-and-space-proof"},
    {"id": "verifier-and-rollback-unchanged", "statement": "verifier authority and exact double Shift rollback are preserved", "test_id": "rollback-and-verifier-proof"}
  ],
