    {"id": "rank-delta-corruption-fault", "kind": "fault_injection", "expected": "a payload with a valid recomputed checksum but wrong rank_delta is rejected by structural validation"},
    {"id": "band-budget-fault", "kind": "fault_injection", "expected": "forced state terminal scratch time or query-symbol exhaustion returns Unresolved and emits no certified lattice"},
    {"id": "v13-v10-index-identity", "kind": "parity", "expected": "V10 binds the same immutable V13 package language states edges forms and bindings under a versioned sidecar format"},
    {"id": "composite-denominator-parity", "kind": "parity", "expected": "the conserved denominator is exactly 382 unique damage_class plus proof_identity pairs"},
    {"id": "v10-target-noninterference", "kind": "parity", "expected": "target labels cannot alter search lattice work completeness latency path or certificate bytes"},
    {"id": "v10-remote-proof-fault", "kind": "fault_injection", "expected": "an interrupted transfer sidecar build or receipt write retains V9 and V7 bytes and leaves installed runtime unchanged"},
    {"id": "v10-target-blind-audit", "kind": "integration", "expected": "one V10 A B C run retains all 382 target forms and lemmas with zero false certificates and zero unresolved"},
    {"id": "v10-resource-screen", "kind": "integration", "expected": "sidecar <=32 MiB loader <=4 MiB two-process PSS delta <=40 MiB scratch <=512 KiB search p99 <=3 ms total p99 <=5 ms and twenty-client total p99 <=5 ms"},
    {"id": "single-banded-owner-scan", "kind": "integration", "expected": "the optimized route has one banded search producer while full-row code is reachable only from tests or proof comparison"},
    {"id": "systemic-source-scan", "kind": "integration", "expected": "no target word class literal coefficient cap timeout increase queue drop fallback or verifier weakening is introduced"},
    {"id": "runtime-noninterference", "kind": "parity", "expected": "Productive V90 bridge runtime storage installed binaries packages daemon and IBus remain byte and process unchanged"}
  ]
