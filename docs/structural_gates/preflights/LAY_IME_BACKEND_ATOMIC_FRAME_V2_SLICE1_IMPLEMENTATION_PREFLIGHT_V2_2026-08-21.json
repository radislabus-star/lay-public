  "runtime_comparisons": [],
  "invariants": [
    {
      "id": "exact-wire-schema",
      "statement": "only the frozen GVariant top level operation tags payload types limits and digest domain are accepted",
      "test_id": "schema-constant-parity"
    },
    {
      "id": "canonical-vectors-only",
      "statement": "only the eight concrete vectors represented by the five canonical vector forms can become FrameReady",
      "test_id": "canonical-vector-grammar"
    },
    {
      "id": "bounded-whole-frame",
      "statement": "the fourth effect or any adapter-advertised bound violation discards all effects and never truncates",
      "test_id": "operation-bound-overflow"
    },
    {
      "id": "atomic-abort-is-sticky",
      "statement": "after one malformed unsupported or overflowing capture every later capture for the event returns AtomicAborted",
      "test_id": "atomic-abort-sticky"
    },
    {
      "id": "no-retained-frame",
      "statement": "finish returns one owned reply and clears collector effects with no take retry or sealed-frame state",
      "test_id": "no-frame-retention"
    },
    {
      "id": "strict-identity-and-digest",
      "statement": "zero mismatched malformed or wrong-length identities and digests reject the whole frame before output",
      "test_id": "frame-identity-parity"
    },
    {
      "id": "terminal-disposition-grammar",
      "statement": "FrameReady has a canonical nonempty vector and every other disposition has zero effects",
      "test_id": "handled-disposition-matrix"
    },
