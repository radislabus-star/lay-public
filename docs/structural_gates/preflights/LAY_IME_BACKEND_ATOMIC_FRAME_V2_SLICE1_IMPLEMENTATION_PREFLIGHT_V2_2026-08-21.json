    }
  ],
  "tests": [
    {"id": "source-edit-fault-policy", "kind": "fault_injection", "expected": "an interrupted edit leaves only isolated source changes and cannot start build deployment or runtime mutation"},
    {"id": "remote-prep-fault-policy", "kind": "fault_injection", "expected": "download or extraction failure writes only the task sandbox and never changes the host package database"},
    {"id": "remote-build-fault-policy", "kind": "fault_injection", "expected": "compile failure retains exact logs and never falls back to local compilation or host installation"},
    {"id": "remote-test-fault-policy", "kind": "fault_injection", "expected": "test failure terminates only the task process and retains complete evidence without D-Bus or input effects"},
    {"id": "evidence-write-fault-policy", "kind": "fault_injection", "expected": "a receipt or graph update failure retains raw proof but prevents a recorded PASS claim"},
    {"id": "schema-constant-parity", "kind": "parity", "expected": "paper and C constants exactly match uuuttay yttttttaya(yv)ay tags 1 through 4 payload types bounds dispositions and digest domain"},
    {"id": "valid-vector-roundtrip", "kind": "unit", "expected": "all eight concrete canonical vectors encode decode and re-encode to the same normal-form bytes"},
    {"id": "malformed-top-level-matrix", "kind": "unit", "expected": "wrong tuple type non-normal form wrong child count and wrong fixed digest lengths all fail closed"},
    {"id": "operation-payload-matrix", "kind": "unit", "expected": "reserved tags wrong inner types invalid UTF-8 empty or oversized text invalid suffix delete cursor bounds and modes all fail closed"},
    {"id": "canonical-vector-grammar", "kind": "unit", "expected": "every duplicate reordered incomplete and unsupported vector is rejected while all eight concrete canonical vectors pass"},
    {"id": "operation-bound-overflow", "kind": "fault_injection", "expected": "effect four and an advertised bound crossing clear the full collector and return AtomicAborted"},
    {"id": "atomic-abort-sticky", "kind": "fault_injection", "expected": "every capture after the first abort returns AtomicAborted and finish exposes zero effects"},
    {"id": "no-frame-retention", "kind": "fault_injection", "expected": "a second finish or capture cannot retrieve reuse or mutate the previously returned reply"},
    {"id": "frame-identity-parity", "kind": "parity", "expected": "all numeric identities the 32-byte capability digest ordered effects and 32-byte effect digest survive exact roundtrip and mismatches reject"},
    {"id": "effect-digest-parity", "kind": "parity", "expected": "independent recomputation over domain type and normal-form vector bytes equals the encoded digest and one-byte mutation rejects"},
    {"id": "lineage-capability-mismatch", "kind": "fault_injection", "expected": "focus epoch or capability epoch or capability digest change clears effects and yields the correct zero-effect terminal disposition"},
    {"id": "handled-disposition-matrix", "kind": "unit", "expected": "handled false with effects aborts handled true without effects is ConsumedNoEffect and only handled true with a canonical vector is FrameReady"},
    {"id": "slice-boundary-static-scan", "kind": "integration", "expected": "the diff contains only the pure module private header unit test two Makefile entries paper evidence and graph outputs with no D-Bus callback or runtime route edits"},
    {"id": "remote-source-hash-parity", "kind": "parity", "expected": "local and remote SHA-256 values match for every compiler input"},
    {"id": "remote-glib-version-parity", "kind": "parity", "expected": "sandbox dev headers and installed runtime share exact Ubuntu package version 2.72.4-0ubuntu2.9 and the deb digest is recorded"},
    {"id": "remote-pure-compile", "kind": "integration", "expected": "remote gcc builds only ibusatomicframe.c plus ibus-atomic-frame.c against the sandbox headers with warnings treated as errors"},
    {"id": "remote-pure-test", "kind": "integration", "expected": "the complete registered GLib unit suite passes remotely with zero skipped or failed cases"},
    {"id": "installed-runtime-parity", "kind": "parity", "expected": "installed IBus daemon libibus GTK modules and Lay daemon hashes remain exact"},
    {"id": "legacy-source-parity", "kind": "parity", "expected": "bus/inputcontext.c src/ibusinputcontext.c and src/ibusinputcontext.h hashes remain exact"}
  ]
}
