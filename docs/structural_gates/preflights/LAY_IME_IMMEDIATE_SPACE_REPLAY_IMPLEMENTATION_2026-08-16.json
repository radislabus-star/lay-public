  "tests": [
    {
      "id": "immediate-boundary-operation",
      "kind": "unit",
      "expected": "test input emits all token key taps with only inter-key sleeps and emits Space immediately after the final release"
    },
    {
      "id": "trace-schema-and-frame-parity",
      "kind": "parity",
      "expected": "valid typed trace rows are grouped only by exact engine_path and tail_epoch; malformed, missing or duplicate fields fail closed"
    },
    {
      "id": "fixed-denominator-output-parity",
      "kind": "parity",
      "expected": "warmup and eligible cases produce their exact expected text and the selected path contains exactly the declared eligible Space events"
    },
    {
      "id": "trace-cardinality-gate",
      "kind": "integration",
      "expected": "every eligible lease frame has display=1, correction=1 and summed field_producer_count<=1"
    },
    {
      "id": "eligible-not-ready-gate",
      "kind": "integration",
      "expected": "eligible not_ready count is zero and lease outcome counts are reported without merging warmup"
    },
    {
      "id": "late-edit-after-fallback-gate",
      "kind": "fault_injection",
      "expected": "the invalidation test and observed trace contain zero delayed committed-tail edits after literal fallback"
    },
    {
      "id": "trace-latency-summary",
      "kind": "integration",
      "expected": "Space and printable p50, p90, p99 and maximum are emitted in microseconds with denominator counts"
    },
    {
      "id": "remote-staging-byte-parity",
      "kind": "parity",
      "expected": "remote guarded release binaries and local staged binaries have identical SHA-256"
    },
    {
      "id": "managed-replay-restoration",
      "kind": "integration",
      "expected": "success, test failure, analyzer failure and timeout all restore the original engine selection and daemon state while global IBus PID and installed SHA remain unchanged"
    },
    {
      "id": "managed-replay-failure-restoration",
      "kind": "fault_injection",
      "expected": "an injected smoke failure still restores the original engine selection and daemon state while global IBus PID and installed SHA remain unchanged"
    },
    {
      "id": "proof-route-failure-preserves-runtime",
      "kind": "fault_injection",
      "expected": "proof implementation or analyzer tests fail before runtime and leave installed processes and bytes unchanged"
    },
    {
      "id": "remote-proof-failure-preserves-runtime",
      "kind": "fault_injection",
      "expected": "remote build or test failure writes no installed files and starts no local runtime"
    }
