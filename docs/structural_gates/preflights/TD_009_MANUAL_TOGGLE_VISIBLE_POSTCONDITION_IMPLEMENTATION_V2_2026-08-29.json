      "kind": "fault_injection"
    },
    {
      "expected": "one stale snapshot yields one refresh claim; duplicate stale callbacks yield no second claim; a later exact snapshot confirms and clears the same pending epoch",
      "id": "stale-then-exact-convergence",
      "kind": "parity"
    },
    {
      "expected": "a compilation or focused-test failure retains only the scoped source diff and cannot modify the installed runtime or evidence",
      "id": "source-repair-fault",
      "kind": "fault_injection"
    },
    {
      "expected": "duplicate and late callbacks cannot emit another delete/commit or synchronize layout twice",
      "id": "duplicate-callback-safety",
      "kind": "fault_injection"
    },
    {
      "expected": "layout and feedback remain unchanged after stale observation and change exactly once after exact confirmation",
      "id": "layout-postcondition-order",
      "kind": "parity"
    },
    {
      "expected": "current Double Shift, text-mutation monopoly, terminal passthrough, candidate visibility, and layout-sync tests pass",
      "id": "double-shift-contract-suite",
      "kind": "integration"
    },
    {
      "expected": "both manual-toggle directions pass alone and in both orders with exact text, one toggle, one refresh at most, malformed trace zero, and exact desktop restoration",
      "id": "managed-gtk-bidirectional-proof",
      "kind": "parity"
    },
    {
      "expected": "any managed GTK setup, assertion, timeout, signal, or teardown failure retains its receipt and restores every captured desktop dimension",
      "id": "managed-desktop-fault",
      "kind": "fault_injection"
    },
    {
      "expected": "installed lay-ibus-engine size and SHA-256 remain exact before and after candidate tests",
      "id": "installed-engine-parity",
      "kind": "parity"
    }
